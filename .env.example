# Copy to .env and fill in from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: auto-fetch real group standings
# WC2026 API (recommended for 2026): https://wc2026api.com — key starts with wc26_
# Or API-Football: https://www.api-football.com (2026 season may need paid plan)

# Vercel / Netlify (optional): protects manual /api/cron-sync-results calls
# CRON_SECRET=
VITE_API_FOOTBALL_KEY=your_wc26_api_key_here

# Netlify Functions (recommended alongside VITE_ above — same wc26_ key)
# API_FOOTBALL_KEY=your_wc26_api_key_here
